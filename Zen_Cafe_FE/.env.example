# Zen Café frontend — local development settings (optional)
# Copy to .env if you need to change the defaults.

# Where the Vite dev server proxies /api requests (the Zen_Cafe_BE server)
BACKEND_URL=http://127.0.0.1:5000

# Extra hostnames allowed to open the dev server (comma separated).
# *.trycloudflare.com is always allowed for phone testing.
# DEV_ALLOWED_HOSTS=my-tunnel.example.com
